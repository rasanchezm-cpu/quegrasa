# ============================================================
# QueGrasa — variables de entorno
# Copia este archivo como .env y llena los valores.
# NUNCA subas el .env real a git (ya está ignorado).
# ============================================================

# ----- Base de datos (Neon PostgreSQL) -----
# Dashboard de Neon -> "Connection string" (usa el -pooler si aparece)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/DBNAME?sslmode=require"

# ----- Auth (sesiones JWT firmadas) -----
# Genera un secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"

# ----- Cloudinary (fotos de las prendas) -----
# Dashboard de Cloudinary -> "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----- Tasa BCV -----
# API pública de la tasa oficial del dólar BCV.
# Si falla un día, el sistema usa la última tasa guardada en la BD.
BCV_API_URL="https://ve.dolarapi.com/v1/dolares/oficial"

# ----- Cron (protege el endpoint que actualiza la tasa) -----
# Vercel Cron llamará a /api/cron/rate con este secreto en el header.
CRON_SECRET="reemplaza-esto-igualmente"

# ----- Datos públicos del catálogo (visibles en el navegador) -----
# Número de WhatsApp de la tienda, formato internacional sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER="584141234567"

# ----- Seed inicial (solo se usa al correr `npx prisma db seed`) -----
ADMIN_EMAIL="admin@quegrasa.app"
ADMIN_PASSWORD="cambiar-antes-de-produccion"
